@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix ies:  <http://ies.data.gov.uk/ontology/ies4#> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix qudt: <http://qudt.org/schema/qudt#> .
@prefix time: <http://www.w3.org/2006/time#> .

# BFO -> IES
obo:BFO_0000011 rdfs:subClassOf ies:Element .   # spatiotemporal region: has spatial extent and start/end, as IES requires of an Element
# All 57 structural candidates rejected: IES State/BoundingState are 4D temporal parts; BFO continuants have none.

# Class declarations, so OWL tools type every IRI above
ies:Element a owl:Class .
obo:BFO_0000011 a owl:Class .
