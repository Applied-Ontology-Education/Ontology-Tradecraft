@prefix ex:   <https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p2/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p2/core> a owl:Ontology ;
    rdfs:label "Project 2 Core"@en ;
    skos:definition "Local classes and relations for Project 2, extending BFO and CCO."@en ;
    owl:imports <https://www.commoncoreontologies.org/CommonCoreOntologiesMerged> .

# ---------------- Task 1: classes ----------------

ex:FixedWing a owl:Class ;
    rdfs:subClassOf cco:ont00000995 ;   # Material Artifact
    rdfs:label "Fixed Wing"@en ;
    skos:definition "A Material Artifact that is a lift-generating wing rigidly attached to an aircraft's fuselage."@en .

# ---------------- Task 1: object properties ----------------

ex:hasManufacturer a owl:ObjectProperty ;
    rdfs:range cco:ont00001180 ;        # Organization
    rdfs:label "has manufacturer"@en ;
    skos:definition "A shortcut relation between a Material Artifact and the Organization that is the agent of the Act of Manufacturing that has that artifact as output."@en .

# ---------------- Task 1: datatype properties on the aircraft ----------------

ex:hasModelBADA a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Model BADA"@en ;
    skos:definition "Relates an aircraft to the model name under which it is listed in the EUROCONTROL Base of Aircraft Data (BADA)."@en .

ex:hasModelFAA a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Model FAA"@en ;
    skos:definition "Relates an aircraft to the model name under which it is listed by the FAA."@en .

ex:hasLengthFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Length Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of a measurement of its length."@en .

ex:hasTailHeightFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Tail Height Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of a measurement of its tail height at operating empty weight."@en .

# ---------------- Task 1 (full): A320neo class with OWL restrictions ----------------

ex:A320neoAircraft a owl:Class ;
    rdfs:label "A320neo Aircraft"@en ;
    skos:definition "An Aircraft that is manufactured in accordance with the Airbus A320neo Artifact Design."@en ;
    rdfs:subClassOf cco:ont00001043 ,                               # Aircraft
        [ a owl:Restriction ;                                       # EL: has some jet engine part
          owl:onProperty obo:BFO_0000178 ; owl:someValuesFrom cco:ont00000533 ] ,
        [ a owl:Restriction ;                                       # EL: has some fixed wing part
          owl:onProperty obo:BFO_0000178 ; owl:someValuesFrom ex:FixedWing ] ,
        [ a owl:Restriction ;                                       # DL only (HermiT); ignored by ELK
          owl:onProperty obo:BFO_0000178 ;
          owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass cco:ont00000533 ] .

ex:A320neoFleet a owl:Class ;
    rdfs:subClassOf obo:BFO_0000027 ;                                # object aggregate
    rdfs:label "A320neo Fleet"@en ;
    skos:definition "An object aggregate whose member parts are all and only the A320neo Aircraft registered with the FAA."@en .

# ---------------- Task 1 (full): plane-level datatype properties ----------------
# Physical makeup and per-plane classifications (true of each A320neo).

ex:hasWingspanWithWingletsFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Wingspan With Winglets Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of its wingspan including winglets or sharklets."@en .
ex:hasWheelbaseFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Wheelbase Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of the distance between its nose gear and main gear."@en .
ex:hasCockpitToMainGearFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Cockpit To Main Gear Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of the distance from its cockpit to its main gear."@en .
ex:hasMainGearWidthFt a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Main Gear Width Ft"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in feet, of the outer width of its main gear."@en .
ex:hasParkingAreaFt2 a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Parking Area Ft2"@en ;
    skos:definition "Shortcut relating an aircraft to the value, in square feet, of the ground area it occupies when parked."@en .
ex:hasNumEngines a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "has Num Engines"@en ;
    skos:definition "Relates an aircraft to the count of engines that are continuant parts of it."@en .
ex:hasMainGearConfig a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Main Gear Config"@en ;
    skos:definition "Relates an aircraft to the FAA code for its main landing gear configuration."@en .
ex:hasPhysicalClassEngine a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Physical Class Engine"@en ;
    skos:definition "Relates an aircraft to the FAA physical class of its engines (e.g. Jet, Turboprop)."@en .
ex:hasAircraftClass a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Aircraft Class"@en ;
    skos:definition "Relates an aircraft to its FAA class (e.g. Fixed-wing, Rotorcraft)."@en .
ex:hasAAC a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has AAC"@en ;
    skos:definition "Relates an aircraft to its Aircraft Approach Category, determined by its approach speed."@en .
ex:hasADG a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has ADG"@en ;
    skos:definition "Relates an aircraft to its Airplane Design Group, determined by its wingspan and tail height."@en .
ex:hasTDG a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has TDG"@en ;
    skos:definition "Relates an aircraft to its Taxiway Design Group, determined by its main gear width and cockpit-to-main-gear distance."@en .
ex:hasICAOWTC a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has ICAO WTC"@en ;
    skos:definition "Relates an aircraft to its ICAO Wake Turbulence Category."@en .
ex:hasFAAWeightClass a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has FAA Weight Class"@en ;
    skos:definition "Relates an aircraft to its FAA weight class."@en .
ex:hasCWT a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has CWT"@en ;
    skos:definition "Relates an aircraft to its FAA Consolidated Wake Turbulence category."@en .
ex:hasOneHalfWakeCategory a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has One Half Wake Category"@en ;
    skos:definition "Relates an aircraft to its 1.5 wake turbulence category."@en .
ex:hasTwoWakeCategoryAppxA a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Two Wake Category Appx A"@en ;
    skos:definition "Relates an aircraft to its two-category wake turbulence classification under FAA Order Appendix A."@en .
ex:hasTwoWakeCategoryAppxB a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Two Wake Category Appx B"@en ;
    skos:definition "Relates an aircraft to its two-category wake turbulence classification under FAA Order Appendix B."@en .
ex:hasSRS a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has SRS"@en ;
    skos:definition "Relates an aircraft to its FAA Same Runway Separation category."@en .
ex:hasLAHSO a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has LAHSO"@en ;
    skos:definition "Relates an aircraft to its Land And Hold Short Operations group."@en .

# ---------------- Task 1 (full): design-level datatype properties ----------------
# Limits and designators: directives and names that hold of the type.

ex:prescribesMTOWLb a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "prescribes MTOW Lb"@en ;
    skos:definition "Shortcut relating an Artifact Design to the maximum takeoff weight, in pounds, it prescribes for aircraft made to it."@en .
ex:prescribesMALWLb a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "prescribes MALW Lb"@en ;
    skos:definition "Shortcut relating an Artifact Design to the maximum allowable landing weight, in pounds, it prescribes for aircraft made to it."@en .
ex:prescribesApproachSpeedKnot a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "prescribes Approach Speed Knot"@en ;
    skos:definition "Shortcut relating an Artifact Design to the certified approach speed, in knots, it prescribes for aircraft made to it."@en .
ex:hasICAOCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has ICAO Code"@en ;
    skos:definition "Relates an Artifact Design to the ICAO aircraft type designator that names it."@en .
ex:hasFAADesignator a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has FAA Designator"@en ;
    skos:definition "Relates an Artifact Design to the FAA aircraft type designator that names it."@en .
ex:hasRemarks a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has Remarks"@en ;
    skos:definition "Relates an Artifact Design to the remarks recorded about it in the FAA aircraft characteristics data."@en .

# ---------------- Task 1 (full): population-level datatype properties ----------------
# Collective facts: true of the fleet, not of any one plane.

ex:hasRegistrationCount a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "has Registration Count"@en ;
    skos:definition "Relates a fleet to the number of its member aircraft on the FAA registry."@en .
ex:hasTMFSOperationsFY24 a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "has TMFS Operations FY24"@en ;
    skos:definition "Relates a fleet to the number of operations by its members recorded by the FAA Traffic Flow Management System in fiscal year 2024."@en .
ex:isOnFAARegistry a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:label "is On FAA Registry"@en ;
    skos:definition "Relates a fleet to whether aircraft of its type appear on the FAA registry."@en .

# ======================= Task 2 =======================

ex:TestProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000228 ;   # Planned Act
    rdfs:label "Test Process"@en ;
    skos:definition "A Planned Act in which one or more participants are put through a prescribed series of operations in order to measure how they perform."@en .

ex:ApproachProcess a owl:Class ;
    rdfs:subClassOf obo:BFO_0000015 ;   # process
    rdfs:label "Approach Process"@en ;
    skos:definition "A process in which an aircraft descends along a final approach path toward a runway, ending at touchdown or at the start of a go-around."@en .

ex:isTemporalPartOf a owl:ObjectProperty ;
    rdfs:subPropertyOf obo:BFO_0000139 ;   # temporal part of
    rdfs:label "is temporal part of"@en ;
    skos:definition "Relates an occurrent to a larger occurrent of which it is a temporal part, i.e. a part that occupies a sub-interval of the larger occurrent's time."@en .

ex:hasMaxApproachSpeedKnot a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:label "has Max Approach Speed Knot"@en ;
    skos:definition "Shortcut relating an Approach Process to the value, in knots, of the maximum speed the aircraft attained during it."@en .

# ======================= Task 3 =======================

ex:SOCEntry a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ;   # Descriptive Information Content Entity
    rdfs:label "SOC Entry"@en ;
    skos:definition "A Descriptive Information Content Entity that is an entry in the 2018 Standard Occupational Classification, describing a kind of occupation."@en .

ex:hasSOCCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has SOC code"@en ;
    skos:definition "Relates a SOC Entry to its Standard Occupational Classification code."@en .

ex:hasSOCLevel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has SOC level"@en ;
    skos:definition "Relates a SOC Entry to its level in the SOC hierarchy (Major, Minor, Broad, or Detailed)."@en .

ex:AerospaceEngineerOccupationRole a owl:Class ;
    rdfs:subClassOf cco:ont00000984 ;   # Occupation Role
    rdfs:label "Aerospace Engineer Occupation Role"@en ;
    skos:definition "An Occupation Role whose bearer is responsible for designing, constructing, and testing aircraft, missiles, and spacecraft."@en .

ex:AerospaceTechnicianOccupationRole a owl:Class ;
    rdfs:subClassOf cco:ont00000984 ;   # Occupation Role
    rdfs:label "Aerospace Engineering Technician Occupation Role"@en ;
    skos:definition "An Occupation Role whose bearer is responsible for operating and maintaining the systems and instruments used to launch, track, and evaluate air and space vehicles."@en .

ex:ActOfAircraftProcessing a owl:Class ;
    rdfs:subClassOf cco:ont00000908 ;   # Act of Artifact Processing
    rdfs:label "Act of Aircraft Processing"@en ;
    skos:definition "An Act of Artifact Processing in which operations are performed on an aircraft, or on materials and equipment intended for one, during its construction or testing."@en .

ex:AdaptabilityEvaluation a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;   # role
    rdfs:label "Adaptability Evaluation"@en ;
    skos:definition "A role borne by an agent, realized in acts that evaluate whether materials and equipment are suited to an aircraft design and its manufacture."@en .

# ======================= Task 3 =======================

ex:SOCEntry a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ;   # Descriptive Information Content Entity
    rdfs:label "SOC Entry"@en ;
    skos:definition "A Descriptive Information Content Entity that is an entry in the 2018 Standard Occupational Classification, describing a kind of occupation."@en .

ex:hasSOCCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has SOC code"@en ;
    skos:definition "Relates a SOC Entry to its Standard Occupational Classification code."@en .

ex:hasSOCLevel a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "has SOC level"@en ;
    skos:definition "Relates a SOC Entry to its level in the SOC hierarchy (Major, Minor, Broad, or Detailed)."@en .

ex:AerospaceEngineerOccupationRole a owl:Class ;
    rdfs:subClassOf cco:ont00000984 ;   # Occupation Role
    rdfs:label "Aerospace Engineer Occupation Role"@en ;
    skos:definition "An Occupation Role whose bearer is responsible for designing, constructing, and testing aircraft, missiles, and spacecraft."@en .

ex:AerospaceTechnicianOccupationRole a owl:Class ;
    rdfs:subClassOf cco:ont00000984 ;   # Occupation Role
    rdfs:label "Aerospace Engineering Technician Occupation Role"@en ;
    skos:definition "An Occupation Role whose bearer is responsible for operating and maintaining the systems and instruments used to launch, track, and evaluate air and space vehicles."@en .

ex:ActOfAircraftProcessing a owl:Class ;
    rdfs:subClassOf cco:ont00000908 ;   # Act of Artifact Processing
    rdfs:label "Act of Aircraft Processing"@en ;
    skos:definition "An Act of Artifact Processing in which operations are performed on an aircraft, or on materials and equipment intended for one, during its construction or testing."@en .

ex:AdaptabilityEvaluation a owl:Class ;
    rdfs:subClassOf obo:BFO_0000023 ;   # role
    rdfs:label "Adaptability Evaluation"@en ;
    skos:definition "A role borne by an agent, realized in acts that evaluate whether materials and equipment are suited to an aircraft design and its manufacture."@en .
