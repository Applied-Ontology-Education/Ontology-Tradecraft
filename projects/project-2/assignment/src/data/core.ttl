###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#has_employment_count_value
CORE:has_employment_count_value rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf owl:topDataProperty ;
                                rdfs:domain CORE:Employment_Estimate_Record ;
                                rdfs:range xsd:integer ;
                                rdfs:label "has employment count value" ;
                                skos:definition "has employement count value" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#has_employment_prse_percent
CORE:has_employment_prse_percent rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf owl:topDataProperty ;
                                 rdfs:domain CORE:Employment_Estimate_Record ;
                                 rdfs:range xsd:decimal ;
                                 rdfs:label "has employment prse percent";
                                 skos:definition "Percent relative standard error (PRSE) for the employment estimate. PRSE is a measure of sampling error, expressed as a percentage of the corresponding estimate. Sampling error occurs when values for a population are estimated from a sample survey of the population, rather than calculated from data for all members of the population. Estimates with lower PRSEs are typically more precise in the presence of sampling error." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#has_establishment_per_occupation_percent
CORE:has_establishment_per_occupation_percent rdf:type owl:DatatypeProperty ;
                                              rdfs:domain CORE:Employment_Estimate_Record ;
                                              rdfs:range xsd:decimal ;
                                              rdfs:label "has establishment per occupation percent";
                                              skos:definition "Percent of establishments reporting the given occupation for the cell. Only available for the national industry estimates; otherwise, this column is blank." .


