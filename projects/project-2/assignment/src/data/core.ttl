###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_area
iao-edit:has_area rdf:type owl:ObjectProperty ;
                  rdfs:domain iao-edit:OEWS_occupation_estimate_entry ;
                  rdfs:range iao-edit:geographic_area ;
                  rdfs:label "has area" ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Relates a statistical estimate entry to the geographic area to which the estimate applies." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_continuant_part
iao-edit:has_continuant_part rdf:type owl:ObjectProperty ;
                             rdfs:domain obo:BFO_0000002 ;
                             rdfs:range obo:BFO_0000002 ;
                             rdfs:label "has continuant part" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A relation between two continuants in which the second continuant is a continuant part of the first." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_manufacturer
iao-edit:has_manufacturer rdf:type owl:ObjectProperty ;
                          rdfs:domain iao-edit:aircraft ;
                          rdfs:range iao-edit:organization ;
                          rdfs:label "has manufacturer" ;
                          <http://www.w3.org/2004/02/skos/core#definition> "Relates an artifact to the organization that manufactures it." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#inheres_in
iao-edit:inheres_in rdf:type owl:ObjectProperty ;
                    rdfs:domain obo:BFO_0000002 ;
                    rdfs:range obo:BFO_0000002 ;
                    obo:IAO_0000115 "A relation between a specifically dependent continuant and the independent continuant on which it depends for its existence." ;
                    rdfs:label "inheres in" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#is_measurement_unit
iao-edit:is_measurement_unit rdf:type owl:ObjectProperty ;
                             rdfs:domain obo:IAO_0000030 ;
                             rdfs:range obo:IAO_0000030 ;
                             rdfs:label "is measurement unit of" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A relation between a measurement unit and the type of quantity or measurement that the unit is used to express." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#is_output_of
iao-edit:is_output_of rdf:type owl:ObjectProperty ;
                      rdfs:domain obo:IAO_0000030 ;
                      rdfs:range obo:BFO_0000015 ;
                      obo:IAO_0000115 "A relation between a measurement unit and the type of quantity or measurement that the unit is used to express." ;
                      rdfs:label "is output of" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#is_temporal_part_of
iao-edit:is_temporal_part_of rdf:type owl:ObjectProperty ;
                             rdfs:domain obo:BFO_0000003 ;
                             rdfs:range obo:BFO_0000003 ;
                             rdfs:label "is temporal part of" ;
                             <http://www.w3.org/2004/02/skos/core#definition> "A relation between two occurrents in which the first occurrent occupies a temporal region that is part of the temporal region occupied by the second occurrent." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#prescribes
iao-edit:prescribes rdf:type owl:ObjectProperty ;
                    rdfs:label "prescribes" ;
                    <http://www.w3.org/2004/02/skos/core#definition> "A relation between a directive information entity and an entity, process, or course of action that the directive specifies, requires, or authorizes." .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#task_3_realizes
iao-edit:task_3_realizes rdf:type owl:ObjectProperty ;
                         rdfs:label "realizes" ;
                         <http://www.w3.org/2004/02/skos/core#definition> "a relation between a process and a realizable entity, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process" .


