#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Act_of_Aircraft_Processing
CORE:Act_of_Aircraft_Processing rdf:type owl:Class ;
                                rdfs:subClassOf www:ont00000908 ;
                                skos:definition "An Act of Material Artifact Processing in which physical operations are performed on an aircraft or its component materials and equipment in order to design, construct, test, change, or preserve it."@en ;
                                rdfs:label "Act of Aircraft Processing" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Adaptability_Evaluation
CORE:Adaptability_Evaluation rdf:type owl:Class ;
                           rdfs:subClassOf www:ont00000636 ;
                           skos:definition "An Act of Appraisal in which an agent evaluates the suitability of materials or equipment for use in an aircraft design or its manufacture."@en ;
                        rdfs:label "Act of Adaptability Evaluation" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Adaptability_Evaluation_Result
CORE:Adaptability_Evaluation_Result rdf:type owl:Class ;
                                    rdfs:subClassOf www:ont00001163 ;
                                    rdfs:label "Adaptability Evaluation Result" ;
                                    skos:definition "A Measurement Information Content Entity that is the output of an Act of Adaptability Evaluation and is about the evaluated materials or equipment and the Artifact Design they are evaluated against."@en .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aerospace_Engineer_Occupation_Role
CORE:Aerospace_Engineer_Occupation_Role rdf:type owl:Class ;
                                        rdfs:subClassOf www:ont00000984 ;
                                        rdfs:label "Aerospace Engineer Occupation Role" ;
                                        skos:definition "Perform engineering duties in designing, constructing, and testing aircraft, missiles, and spacecraft. May conduct basic and applied research to evaluate adaptability of materials and equipment to aircraft design and manufacture. May recommend improvements in testing equipment and techniques." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aerospace_Engineering_and_Operations_Technician_Occupation_Role
CORE:Aerospace_Engineering_and_Operations_Technician_Occupation_Role rdf:type owl:Class ;
                                                                     rdfs:subClassOf www:ont00000984 ;
                                                                     rdfs:label "Aerospace Engineering and Operations Technician Occupation Role" ;
                                                                     skos:definition "Operate, install, adjust, and maintain integrated computer/communications systems, consoles, simulators, and other data acquisition, test, and measurement instruments and equipment, which are used to launch, track, position, and evaluate air and space vehicles. May record and interpret test data." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Airbus_A320_Neo_Aircraft
CORE:Airbus_A320_Neo_Aircraft rdf:type owl:Class ;
                              rdfs:subClassOf CORE:Twin_Jet_Aircraft ;
                              rdfs:label "Airbus A320 Neo Aircraft" ;
                              skos:definition "A twin jet engine aircraft with a code of A320 Neo by Airbus" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Airbus_A321_Aircraft
CORE:Airbus_A321_Aircraft rdf:type owl:Class ;
                          rdfs:subClassOf CORE:Twin_Jet_Aircraft ;
                          rdfs:label "Airbus A321 Aircraft" ;
                          skos:definition "A twin jet engine aircraft with a code of A321 by Airbus" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Approach_Category_Designation
CORE:Aircraft_Approach_Category_Designation rdf:type owl:Class ;
                                            rdfs:subClassOf CORE:Aircraft_Classification_Category_Designation ;
                                            rdfs:label "Aircraft Approach Category Designation" ;
                                            skos:definition "Aircraft Approach Category Designation" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Approach_Category_Scheme
CORE:Aircraft_Approach_Category_Scheme rdf:type owl:Class ;
                                       rdfs:subClassOf CORE:Aircraft_Classification_Scheme ;
                                       rdfs:label "Aircraft Approach Category Scheme" ;
                                       skos:definition "AAC is determined based on the highest reported Approach Speed/Stall Speed in Flight Standardization Board (FSB) or aircraft manufacturer's documentation. For aircraft with a single reported AAC value, columns I and J are empty." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Classification_Assignment
CORE:Aircraft_Classification_Assignment rdf:type owl:Class ;
                                        rdfs:subClassOf www:ont00000853 ;
                                        rdfs:label "Aircraft Classification Assignment" ;
                                        skos:definition "assignment of the aircraft classification scheme" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Classification_Category_Designation
CORE:Aircraft_Classification_Category_Designation rdf:type owl:Class ;
                                                  rdfs:subClassOf CORE:Classification_Category_Designation ;
                                                  rdfs:label "Aircraft Classification Category Designation" ;
                                                  skos:definition "aircraft category information" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Classification_Scheme
CORE:Aircraft_Classification_Scheme rdf:type owl:Class ;
                                    rdfs:subClassOf CORE:Classification_Scheme ;
                                    rdfs:label "Aircraft Classification Scheme" ;
                                    skos:definition "scheme that allows to classify aircraft data." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Design_Group_Designation
CORE:Aircraft_Design_Group_Designation rdf:type owl:Class ;
                                       rdfs:subClassOf CORE:Aircraft_Classification_Category_Designation ;
                                       rdfs:label "Aircraft Design Group Designation" ;
                                       skos:definition "Aircraft Design Group Designation" .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Design_Group_Scheme
CORE:Aircraft_Design_Group_Scheme rdf:type owl:Class ;
                                  rdfs:subClassOf CORE:Aircraft_Classification_Scheme ;
                                  rdfs:label "Aircraft Design Group Scheme" ;
                                  skos:definition "scheme that allows to classify aircraft design group data ADG is determined based on combination of Tail Height and Wingspan per FAA AC 150/5300-13B." .


###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#Aircraft_Measurement_Record
CORE:Aircraft_Measurement_Record rdf:type owl:Class ;
                                 rdfs:subClassOf www:ont00000253 ;
                                 rdfs:label "Aircraft Measurement Record" ;
                                 skos:definition "IBE for Aircraft meassurements" .


