###  https://spec.industrialontologies.org/ontology/construct/Manufacturer
<https://spec.industrialontologies.org/ontology/construct/Manufacturer> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://purl.example.com/aircraft/0000001> ;
                                                                        <http://purl.obolibrary.org/obo/IAO_0000412> "https://spec.industrialontologies.org/ontology/202602/core/Core/" ;
                                                                        rdfs:isDefinedBy "https://spec.industrialontologies.org/ontology/core/Core/"^^xsd:anyURI ;
                                                                        rdfs:label "manufacturer"@en-us ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> "An organization that manufactures something." ;
                                                                        <http://www.w3.org/2004/02/skos/core#example> "MiliporeSigma is a manufacturer of single-use bioreactors; Boeing is a manufacturer of airplanes; dell is a manufacturer of lap-tops"@en-us ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/explanatoryNote> "See the expanded definition under the corresponding role class. The term is formalized here as a defined class by referring to its corresponding role class and exists primarily for ontological modeling and implementation convenience." ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicDefinition> "Manufacturer(x) ↔ Organization(x) ∧ ∃r(ManufacturerRole(r) ∧ hasRole(x,r))" ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> "organization which has a manufacturer role"@en-us ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageDefinition> "every instance of 'manufacturer' is defined as exactly an instance of 'organization' that 'has role' some 'manufacturer role'" .


