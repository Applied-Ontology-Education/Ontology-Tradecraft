###  http://purl.obolibrary.org/obo/IAO_0000708
obo:IAO_0000708 rdf:type owl:Class ;
                rdfs:subClassOf obo:IAO_0000578 ;
                obo:IAO_0000114 obo:IAO_0000125 ;
                obo:IAO_0000115 "A centrally registered identifier that is issued by ORCID (https://orcid.org/) and used to persistantly identify oneself as a human researcher or contributor." ;
                obo:IAO_0000116 "\"You can connect your iD with your professional information — affiliations, grants, publications, peer review, and more. You can use your iD to share your information with other systems, ensuring you get recognition for all your contributions, saving you time and hassle, and reducing the risk of errors.\" [https://orcid.org/]" ,
                                "This class was originally defined in Apollo_SV (http://purl.obolibrary.org/obo/APOLLO_SV_00000496) but due to it being more in scope of IAO, it was decided to add it to IAO and deprecate its Apollo_SV equivalent. (2022-10-25)" ;
                obo:IAO_0000117 "http://orcid.org/0000-0002-1595-3213" ;
                obo:IAO_0000118 "ORCID ID" ,
                                "ORCiD" ,
                                "Open Researcher and Contributor ID" ,
                                "Open Researcher and Contributor Identifier" ;
                obo:IAO_0000119 "https://orcid.org/" ;
                obo:IAO_0000233 "https://github.com/information-artifact-ontology/IAO/issues/259" ;
                rdfs:label "ORCID identifier"@en .


