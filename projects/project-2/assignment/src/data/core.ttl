                                              rdfs:range xsd:integer ;
                                              obo:IAO_0000115 "Relates an approach-speed specification to the maximum approach-speed value that it specifies." ;
                                              rdfs:label "has specified maximum approach speed" .


###  http://purl.obolibrary.org/obo/iao/iao-edit.owl#has_total_employment_source_value
iao-edit:has_total_employment_source_value rdf:type owl:DatatypeProperty ;
                                           rdfs:range xsd:integer ;
