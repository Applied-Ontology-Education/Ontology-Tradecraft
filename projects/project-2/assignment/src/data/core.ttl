obo:BFO_0000055 rdf:type owl:ObjectProperty ;
                rdfs:label "realizes"^^xsd:string ;
                skos:definition "b realizes c. Def b is a process and c is a realizable entity and b is the process in which c is exhibited (BFO 2020)." .

obo:BFO_0000197 rdf:type owl:ObjectProperty ;
                rdfs:label "inheres in"^^xsd:string ;
                skos:definition "b inheres in c. Def b is a quality or disposition and c is an independent continuant and b is a characteristic of c (BFO 2020)." .

www:ont00001808 rdf:type owl:ObjectProperty ;
                rdfs:label "is about"^^xsd:string ;
                skos:definition "b is about cDef b is a generically dependent continuant and c is an independent continuant and b is a characteristic of c (BFO 2020)." .

www:ont00001816 rdf:type owl:ObjectProperty ;
                rdfs:label "is output of"^^xsd:string ;
                skos:definition "b is output of c. Def b is a process and c is an independent continuant and b is the process in which c is exhibited (BFO 2020)." .



<http://www.semanticweb.org/shannon/ontologies/2026/8/CORE> rdf:type owl:Ontology ;
    # owl:imports <https://www.commoncoreontologies.org/2026-08-13/AllCoreOntology> ;
