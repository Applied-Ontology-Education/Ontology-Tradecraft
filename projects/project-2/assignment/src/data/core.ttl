###  http://www.semanticweb.org/shannon/ontologies/2026/8/CORE#has_location_quotient
CORE:has_location_quotient rdf:type owl:DatatypeProperty ;
                           rdfs:domain CORE:Employment_Estimate_Record ;
                           rdfs:range xsd:decimal ;
                           rdfs:label "has location quotient";
                           skos:definition "The location quotient represents the ratio of an occupation’s share of employment in a given area to that occupation’s share of employment in the U.S. as a whole. For example, an occupation that makes up 10 percent of employment in a specific metropolitan area compared with 2 percent of U.S. employment would have a location quotient of 5 for the area in question. Only available for the state, metropolitan area, and nonmetropolitan area estimates; otherwise, this column is blank." .


