    ex:hasHourlyWagePct90 "98.97"^^xsd:decimal ;
    ex:hasAnnualWagePct10 "85350"^^xsd:decimal ;
    ex:hasAnnualWagePct25 "104740"^^xsd:decimal ;
    ex:hasAnnualWageMedian "134830"^^xsd:decimal ;
    ex:hasAnnualWagePct75 "174480"^^xsd:decimal ;
    ex:hasAnnualWagePct90 "205850"^^xsd:decimal .

ex:TotEmp_17_2011 a ex:TotalEmploymentMeasurement ;
    rdfs:label "Total Employment"@en ;
    skos:altLabel "Total Employment, 17-2011, U.S., May 2024"@en ;
    skos:definition "The OEWS May 2024 count of persons employed in occupation 17-2011 in the United States."@en ;
    cco:ont00001966 ex:Pop_Eng ;                                  # is a measurement of
