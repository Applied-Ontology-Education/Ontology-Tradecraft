    ot:hasHourlyMedianWage "64.82"^^xsd:decimal ;
    ot:hasHourlyWage75thPercentile "83.88"^^xsd:decimal ;
    ot:hasHourlyWage90thPercentile "98.97"^^xsd:decimal ;
    ot:hasAnnualWage10thPercentile "85350"^^xsd:decimal ;
    ot:hasAnnualWage25thPercentile "104740"^^xsd:decimal ;
    ot:hasAnnualMedianWage "134830"^^xsd:decimal ;
    ot:hasAnnualWage75thPercentile "174480"^^xsd:decimal ;
    ot:hasAnnualWage90thPercentile "205850"^^xsd:decimal .

otd:totEmp_17-2010 a ot:TotalEmployment ;
    rdfs:label "Total Employment"@en ;
    skos:altLabel "Total Employment - 17-2010 Aerospace Engineers (broad), U.S., May 2024"@en ;
    skos:definition "The OEWS May 2024 estimate of total employment for the broad occupation 17-2010 Aerospace Engineers in the U.S."@en ;
    cco:ont00001966 otd:popSize_AerospaceEngineers_US_May2024 ;   # is a measurement of
    obo:BFO_0000084 otd:OEWS_May2024_nationalFile ;     # generically depends on (carried by the same file as the record)
    ot:hasEmploymentCount "68440"^^xsd:integer .

