:population_17_2010 a core:Population ;
    rdfs:label "Aerospace Engineers population (SOC 17-2010, U.S., cross-industry)" ;
    skos:definition "The aggregate of persons in the United States, cross-industry, occupying the SOC 17-2010 Aerospace Engineers broad occupation." .

:totalEmployment_17_2010 a core:TotalEmployment ;
    rdfs:label "Total Employment" ;
    skos:definition "The Total Employment quality of the SOC 17-2010 U.S. cross-industry population, measured at 68440 for May 2024." ;
    core:inheresIn :population_17_2010 ;
    core:hasTotalEmploymentValue "68440"^^xsd:integer .

:measuringAct_17_2010 a core:ActOfMeasuring ;
    rdfs:label "Act of Measuring Total Employment (SOC 17-2010, May 2024)" ;
    skos:definition "The BLS OEWS act of measuring that determined the May 2024 Total Employment value for SOC 17-2010." ;
    core:isAbout :totalEmployment_17_2010 .

