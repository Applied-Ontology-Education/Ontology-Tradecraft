                                   CORE:has_cockpit_to_main_gear_ft "50.2"^^xsd:decimal ;
                                   CORE:has_length_ft "123.3"^^xsd:decimal ;
                                   CORE:has_main_gear_width_ft "29.4"^^xsd:decimal ;
                                   CORE:has_maximum_allowable_landing_weight_lb "148591"^^xsd:integer ;
                                   CORE:has_maximum_takeoff_gross_weight_lb "174165"^^xsd:integer ;
                                   CORE:has_minimum_parking_position_area_ft2 "16358.3"^^xsd:decimal ;
                                   CORE:has_model_BADA "Airbus A320-271N" ;
                                   CORE:has_model_FAA "Airbus A320 Neo" ;
                                   CORE:has_remark_text "AAC validated by Flight Standardization Board (FSB) report." ;
                                   CORE:has_tail_height_at_OEW_ft "39.6"^^xsd:decimal ;
                                   CORE:has_wheelbase_ft "41.5"^^xsd:decimal ;
