ex:population-occ-17-2010
    a ex:OccupationalPopulation ;
    rdfs:label "United States population employed under OCC 17-2010"@en ;
    skos:definition "The population of persons represented in the May 2024 national employment estimate for broad occupation 17-2010 Aerospace Engineers."@en .

ex:measurement-act-occ-17-2010
    a ex:ActOfMeasuring ;
    rdfs:label "Act of measuring total employment for OCC 17-2010"@en ;
    skos:definition "The act of measuring the total United States employment associated with OCC 17-2010 in the May 2024 OEWS data."@en ;
    bfo:0000057 ex:population-occ-17-2010 .

ex:total-employment-occ-17-2010
    a ex:TotalEmployment ;
    rdfs:label "Total Employment"@en ;
    skos:definition "The measured total employment value for OCC 17-2010 Aerospace Engineers in the May 2024 national OEWS data."@en ;
