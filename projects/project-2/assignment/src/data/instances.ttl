    ot:hasOCCTitle "Aerospace Engineers"^^xsd:string ;
    ot:oGroup "broad"^^xsd:string ;
    ot:hasEmploymentPRSE "2.3"^^xsd:decimal ;
    ot:hasHourlyMeanWage "67.88"^^xsd:decimal ;
