###  http://purl.example.com/aircraft/0000001
<http://purl.example.com/aircraft/0000001> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000027> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T15:53:44Z"^^xsd:dateTime ;
                                           rdfs:label "Organization"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "On object aggregate that is a group of people." .


###  http://purl.example.com/aircraft/0000024
<http://purl.example.com/aircraft/0000024> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T17:45:39Z"^^xsd:dateTime ;
                                           rdfs:label "AAC Category"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity categorizing an aircraft based on a range of the  highest reported Approach Speed/Stall Speed in Flight Standardization Board (FSB) or aircraft manufacturer's documentation." .


###  http://purl.example.com/aircraft/0000025
<http://purl.example.com/aircraft/0000025> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T17:46:05Z"^^xsd:dateTime ;
                                           rdfs:label "ADG Category"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's Aircraft Design Group classification. ADG is determined based on combination of Tail Height and Wingspan per FAA AC 150/5300-13B." .


###  http://purl.example.com/aircraft/0000026
<http://purl.example.com/aircraft/0000026> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T17:46:21Z"^^xsd:dateTime ;
                                           rdfs:label "TDG Category"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's FAA Taxiway Design Group classification." .


###  http://purl.example.com/aircraft/0000035
<http://purl.example.com/aircraft/0000035> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:28:04Z"^^xsd:dateTime ;
                                           rdfs:label "Main Gears Configuration Category"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that is about the main gears in an aircraft." .


###  http://purl.example.com/aircraft/0000037
<http://purl.example.com/aircraft/0000037> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:30:15Z"^^xsd:dateTime ;
                                           rdfs:label "ICAO WTC"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes the category of weight teurbelence in an aircraft." .


###  http://purl.example.com/aircraft/0000039
<http://purl.example.com/aircraft/0000039> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:35:41Z"^^xsd:dateTime ;
                                           rdfs:label "FAA Weight Class"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that denotes the category of FAA weight class." .


###  http://purl.example.com/aircraft/0000041
<http://purl.example.com/aircraft/0000041> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:38:41Z"^^xsd:dateTime ;
                                           rdfs:label "Consolidated Weight Class Category"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes the wake-turbulence weight category the Federal Aviation Administration assigns to an aircraft on the basis of its maximum certificated takeoff weight." .


###  http://purl.example.com/aircraft/0000043
<http://purl.example.com/aircraft/0000043> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:44:47Z"^^xsd:dateTime ;
                                           rdfs:label "RECAT 2 Wake Category (Appendix A)"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's FAA Wake Turbulence Recategorization (RECAT 2) classification under Appendix A, assigning it to one of categories A through G on the basis of the aircraft's wingspan and maximum takeoff weight." .


###  http://purl.example.com/aircraft/0000044
<http://purl.example.com/aircraft/0000044> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:44:58Z"^^xsd:dateTime ;
                                           rdfs:label "RECAT 2 Wake Category (Appendix B)"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's FAA Wake Turbulence Recategorization (RECAT 2) classification under Appendix B, assigning it to one of categories A through G on the basis of the aircraft's wingspan and maximum takeoff weight." .


###  http://purl.example.com/aircraft/0000045
<http://purl.example.com/aircraft/0000045> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:45:06Z"^^xsd:dateTime ;
                                           rdfs:label "SRS"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's Same Runway Separation (SRS) category, which determines the required separation between that aircraft, when departing, and a preceding departing or arriving aircraft using the same runway." .


###  http://purl.example.com/aircraft/0000046
<http://purl.example.com/aircraft/0000046> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T18:45:16Z"^^xsd:dateTime ;
                                           rdfs:label "LAHSO"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A Descriptive Information Content Entity that describes an aircraft's Land and Hold Short Operations (LAHSO) group, assigning it to one of ten groups used to determine the aircraft's eligibility for land-and-hold-short runway clearances." .


###  http://purl.example.com/aircraft/0000118
<http://purl.example.com/aircraft/0000118> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000015> ;
                                           <http://purl.org/dc/elements/1.1/creator> <https://orcid.org/0000-0002-0443-3036> ;
                                           <http://purl.org/dc/elements/1.1/date> "2026-09-10T22:32:27Z"^^xsd:dateTime ;
                                           rdfs:label "Test Process"@en ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "A process that test for something." .


###  https://spec.industrialontologies.org/ontology/construct/Manufacturer
<https://spec.industrialontologies.org/ontology/construct/Manufacturer> rdf:type owl:Class ;
                                                                        rdfs:subClassOf <http://purl.example.com/aircraft/0000001> ;
                                                                        <http://purl.obolibrary.org/obo/IAO_0000412> "https://spec.industrialontologies.org/ontology/202602/core/Core/" ;
                                                                        rdfs:isDefinedBy "https://spec.industrialontologies.org/ontology/core/Core/"^^xsd:anyURI ;
                                                                        rdfs:label "manufacturer"@en-us ;
                                                                        <http://www.w3.org/2004/02/skos/core#definition> "An organization that manufactures something." ;
                                                                        <http://www.w3.org/2004/02/skos/core#example> "MiliporeSigma is a manufacturer of single-use bioreactors; Boeing is a manufacturer of airplanes; dell is a manufacturer of lap-tops"@en-us ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/explanatoryNote> "See the expanded definition under the corresponding role class. The term is formalized here as a defined class by referring to its corresponding role class and exists primarily for ontological modeling and implementation convenience." ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/firstOrderLogicDefinition> "Manufacturer(x) ↔ Organization(x) ∧ ∃r(ManufacturerRole(r) ∧ hasRole(x,r))" ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/naturalLanguageDefinition> "organization which has a manufacturer role"@en-us ;
                                                                        <https://spec.industrialontologies.org/ontology/annotation/semiFormalNaturalLanguageDefinition> "every instance of 'manufacturer' is defined as exactly an instance of 'organization' that 'has role' some 'manufacturer role'" .


###  https://www.commoncoreontologies.org/ont00000120
<https://www.commoncoreontologies.org/ont00000120> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000853> ;
