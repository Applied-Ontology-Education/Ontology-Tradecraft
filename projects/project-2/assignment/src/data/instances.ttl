                               CORE:has_RECAT_2_wake_category_designation CORE:RECAT_2.0_Apndx_A_D ,
                                                                          CORE:RECAT_2.0_Apndx_B_C ;
                               CORE:has_aircraft_approach_category_designation CORE:AAC_D ;
                               CORE:has_aircraft_design_group_designation CORE:ADG_III ;
                               CORE:has_consolidated_wake_turbulence_category_designation CORE:CWT_F ;
                               CORE:has_main_gear_configuration_designation CORE:MGC_D ;
                               CORE:has_manufacturer CORE:Airbus ;
                               CORE:has_maximum_aircraft_approach_category_designation CORE:AAC_D ;
                               CORE:has_minimum_aircraft_approach_category_designation CORE:AAC_C ;
                               CORE:has_same_runway_seperation_designation CORE:SRS_3 ;
                               CORE:has_taxiway_design_group_designation CORE:TDG_3 ;
                               CORE:has_weight_class_designation CORE:Large ;
                               www:ont00001942 CORE:A321_Prescribed_Maximum_Approach_Speed ;
                               CORE:has_FAA_designator_code "A321" ;
                               CORE:has_FAA_registration_count 491 ;
                               CORE:has_FAA_registry_entry_indicator "true"^^xsd:boolean ;
                               CORE:has_ICAO_code "A321" ;
                               CORE:has_TMFS_FY24_operation_count "1364686"^^xsd:nonNegativeInteger ;
                               CORE:has_approach_speed_knot "142"^^xsd:integer ;
                               CORE:has_cockpit_to_main_gear_ft "64.2"^^xsd:decimal ;
                               CORE:has_length_ft "146.0"^^xsd:decimal ;
                               CORE:has_main_gear_width_ft "29.4"^^xsd:decimal ;
                               CORE:has_maximum_allowable_landing_weight_lb "171520"^^xsd:integer ;
                               CORE:has_maximum_approach_speed_knot "142"^^xsd:integer ;
                               CORE:has_maximum_takeoff_gross_weight_lb "200621"^^xsd:integer ;
                               CORE:has_minimum_approach_speed_knot "140"^^xsd:integer ;
                               CORE:has_minimum_parking_position_area_ft2 "19256.3"^^xsd:decimal ;
                               CORE:has_model_BADA "Airbus A321-111" ;
                               CORE:has_model_FAA "Airbus A321" ;
                               CORE:has_remark_text "The final approach speed is 140 knot at a MALW of 166,449 lb and classifies the aircraft into the AAC C while approach speed is 142 knot at a MALW of 171,520 lb and classifies into the AAC D. AAC validated by Flight Standardization Board (FSB) report." ;
                               CORE:has_tail_height_at_OEW_ft "39.7"^^xsd:decimal ;
                               CORE:has_wheelbase_ft "55.5"^^xsd:decimal ;
                               CORE:has_wingspan_with_winglets_or_sharklets_ft "117.5"^^xsd:decimal ;
                               CORE:has_wingspan_without_winglets_or_sharklets_ft "111.9"^^xsd:decimal ;
