    ex:correspondsToSOCEntry ex:SOC_17_2010 ;
    ex:hasArea ex:UnitedStates ;
    ex:hasNAICSCode "0"^^xsd:string ;
    ex:hasNAICSTitle "Cross-industry"^^xsd:string ;
    ex:hasIndustryGroup "cross-industry"^^xsd:string ;
    ex:ownCode "1235"^^xsd:string ;
    ex:hasOCCCode "17-2010"^^xsd:string ;
    ex:oGroup "broad"^^xsd:string ;
    ex:hasTotalEmployment ex:TotEmp_17_2010 ;
    ex:hasHourlyMeanWage "67.88"^^xsd:decimal ;
    ex:hasAnnualMeanWage "141180"^^xsd:decimal ;
    ex:hasMeanWageRSEPct "0.8"^^xsd:decimal ;
