otd:OCC_17-3021 a ot:OEWSRecord ;
    rdfs:label "OCC: Aerospace Engineering and Operations Technologists and Technicians (17-3021, detailed)"@en ;
    skos:definition "The OEWS May 2024 national cross-industry record for the SOC detailed occupation 17-3021 Aerospace Engineering and Operations Technologists and Technicians."@en ;
    obo:BFO_0000084 otd:OEWS_May2024_nationalFile ;     # generically depends on
