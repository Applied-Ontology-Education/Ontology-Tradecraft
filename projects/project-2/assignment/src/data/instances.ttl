otd:OCC_17-2011 a ot:OEWSRecord ;
    rdfs:label "OCC: Aerospace Engineers (17-2011, detailed)"@en ;
    skos:definition "The OEWS May 2024 national cross-industry record for the SOC detailed occupation 17-2011 Aerospace Engineers."@en ;
