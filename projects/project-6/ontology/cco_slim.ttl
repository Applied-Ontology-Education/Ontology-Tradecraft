                                                            <https://www.commoncoreontologies.org/ont00000263> ;
                                                   rdfs:label "Twenty-Four-Hour Clock Time System"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#altLabel> "24-Hour Clock"@en ,
