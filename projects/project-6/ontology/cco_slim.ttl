###  https://www.commoncoreontologies.org/ont00001624
<https://www.commoncoreontologies.org/ont00001624> rdf:type owl:NamedIndividual ,
                                                            <https://www.commoncoreontologies.org/ont00001235> ;
                                                   rdfs:label "Golf Time Zone"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Offset from Universal Coordinated Time = UTC+7"@en ;
