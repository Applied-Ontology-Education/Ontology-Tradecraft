###  https://www.commoncoreontologies.org/ont00000225
<https://www.commoncoreontologies.org/ont00000225> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000202> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://www.commoncoreontologies.org/ont00001869> ;
                                                                     owl:someValuesFrom <https://www.commoncoreontologies.org/ont00000832>
                                                                   ] ;
                                                   rdfs:label "Month"@en ;
                                                   <http://www.w3.org/2004/02/skos/core#definition> "A Temporal Interval that is based on the approximate length of time required for a Natural Satellite to complete one cycle of its rotational motion around its Primary Body."@en ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Unless otherwise specified, it is assumed that a Month is specified relative to the Rotational Motion of the Moon around the Earth. Earth Months are approximately equal to four consecutive Weeks or 30 consecutive Days."@en ;
                                                   <https://www.commoncoreontologies.org/ont00001754> "http://wordnetweb.princeton.edu/perl/webwn?s=month" ;
                                                   <https://www.commoncoreontologies.org/ont00001760> <https://www.commoncoreontologies.org/TimeOntology> .


