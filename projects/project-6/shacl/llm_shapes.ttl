@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix p6: <https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/IdentifierShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Identifier must designate exactly one entity." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cco:ont00001916 ],
        [ sh:message "Identifier must be carried by exactly one GTFSRecord with one non-empty xsd:string text value." ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class p6:GTFSRecord ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minLength 1 ;
                            sh:path cco:ont00001765 ] ] ] ;
    sh:targetClass cco:ont00000003,
        cco:ont00000077,
        cco:ont00000923 .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/RailStationShape> a sh:NodeShape ;
    sh:property [ sh:class cco:ont00000487 ;
            sh:maxCount 1 ;
            sh:message "RailStation must be located in exactly one Geospatial Location." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path obo:BFO_0000171 ],
        [ sh:message "RailStation must be designated by exactly one Designative Name." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000003 ] ],
        [ sh:message "RailStation must be designated by exactly one Arbitrary Identifier (stop_id)." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000923 ] ],
        [ sh:message "RailStation may be designated by at most one Code Identifier (stop_code)." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000077 ] ] ;
    sh:targetClass p6:RailStation .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/RouteShape> a sh:NodeShape ;
    sh:property [ sh:message "Route must be carried by a GTFSRecord with one integer routeTypeCode (0..1702)." ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class p6:GTFSRecord ;
                    sh:property [ sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:maxInclusive 1702 ;
                            sh:minCount 1 ;
                            sh:minInclusive 0 ;
                            sh:path p6:routeTypeCode ] ] ],
        [ sh:message "Route must be designated by exactly one Designative Name (route_long_name)." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000003 ] ] ;
    sh:targetClass p6:TransitRouteSpecification .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/ScheduledStopShape> a sh:NodeShape ;
    sh:property [ sh:class p6:TrainTripSpecification ;
            sh:maxCount 1 ;
            sh:message "Stop must be a continuant part of exactly one TrainTripSpecification." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path obo:BFO_0000176 ],
        [ sh:message "Stop must have exactly one departure Time of Day Identifier as a part." ;
            sh:path [ sh:inversePath obo:BFO_0000176 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000827 ;
                    sh:property [ sh:hasValue "departure time" ;
                            sh:path rdfs:label ] ] ],
        [ sh:class p6:RailStation ;
            sh:maxCount 1 ;
            sh:message "Stop must be about exactly one RailStation." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cco:ont00001808 ],
        [ sh:message "Stop must be carried by exactly one GTFSRecord with an integer stopSequence >= 0." ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class p6:GTFSRecord ;
                    sh:property [ sh:datatype xsd:integer ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:minInclusive 0 ;
                            sh:path p6:stopSequence ] ] ],
        [ sh:message "Stop must have exactly one arrival Time of Day Identifier as a part." ;
            sh:path [ sh:inversePath obo:BFO_0000176 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000827 ;
                    sh:property [ sh:hasValue "arrival time" ;
                            sh:path rdfs:label ] ] ] ;
    sh:targetClass p6:ScheduledStopSpecification .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/StationCoordinateRecordShape> a sh:NodeShape ;
    sh:property [ sh:class cco:ont00000487 ;
            sh:maxCount 1 ;
            sh:message "StationCoordinateRecord must be about exactly one Geospatial Location." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path cco:ont00001808 ],
        [ sh:maxCount 1 ;
            sh:message "StationCoordinateRecord must be carried by exactly one valid GTFSRecord." ;
            sh:minCount 1 ;
            sh:node <https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/CoordinateCarrierShape> ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ] ;
    sh:targetClass p6:StationCoordinateRecord .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/TimeOfDayShape> a sh:NodeShape ;
    sh:property [ sh:in ( "arrival time" "departure time" ) ;
            sh:maxCount 1 ;
            sh:message "Time of Day Identifier must be labelled exactly 'arrival time' or 'departure time'." ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class p6:ScheduledStopSpecification ;
            sh:maxCount 1 ;
            sh:message "Time of Day Identifier must be a continuant part of exactly one ScheduledStopSpecification." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path obo:BFO_0000176 ],
        [ sh:message "Time of Day Identifier must be carried by exactly one GTFSRecord with raw HH:MM:SS text (hours may exceed 24) and an xsd:dateTime with a New York offset (-05:00/-04:00)." ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class p6:GTFSRecord ;
                    sh:property [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path cco:ont00001765 ;
                            sh:pattern "^[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]$" ],
                        [ sh:datatype xsd:dateTime ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path cco:ont00001767 ;
                            sh:pattern "(-05:00|-04:00)$" ] ] ] ;
    sh:targetClass cco:ont00000827 .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/TripShape> a sh:NodeShape ;
    sh:property [ sh:class p6:TransitRouteSpecification ;
            sh:maxCount 1 ;
            sh:message "Trip must be a continuant part of exactly one TransitRouteSpecification." ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path obo:BFO_0000176 ],
        [ sh:message "Trip must be designated by exactly one Code Identifier (trip_short_name)." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000077 ] ],
        [ sh:message "Trip must be designated by exactly one Arbitrary Identifier (trip_id)." ;
            sh:path [ sh:inversePath cco:ont00001916 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class cco:ont00000923 ] ],
        [ sh:message "Trip must be carried by exactly one GTFSRecord with directionCode (0/1), isPeakService (boolean) and optional headsignText (string)." ;
            sh:path [ sh:inversePath obo:BFO_0000101 ] ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape [ sh:class p6:GTFSRecord ;
                    sh:property [ sh:datatype xsd:integer ;
                            sh:in ( 0 1 ) ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path p6:directionCode ],
                        [ sh:datatype xsd:boolean ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path p6:isPeakService ],
                        [ sh:datatype xsd:string ;
                            sh:maxCount 1 ;
                            sh:minLength 1 ;
                            sh:path p6:headsignText ] ] ] ;
    sh:targetClass p6:TrainTripSpecification .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/WheelchairBoardingRecordShape> a sh:NodeShape ;
    sh:class p6:GTFSRecord ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:maxInclusive 2 ;
            sh:message "wheelchairBoardingCode must be a single xsd:integer in 0..2." ;
            sh:minInclusive 0 ;
            sh:path p6:wheelchairBoardingCode ] ;
    sh:targetSubjectsOf p6:wheelchairBoardingCode .

<https://stucker7-buffalo-edu.github.io/ontology-tradecraft/p6/shapes/CoordinateCarrierShape> a sh:NodeShape ;
    sh:class p6:GTFSRecord ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 90.0 ;
            sh:message "Latitude must be one xsd:decimal in [-90, 90]." ;
            sh:minCount 1 ;
            sh:minInclusive -90.0 ;
            sh:path cco:ont00001766 ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:maxInclusive 180.0 ;
            sh:message "Longitude must be one xsd:decimal in [-180, 180]." ;
            sh:minCount 1 ;
            sh:minInclusive -180.0 ;
            sh:path cco:ont00001764 ] .

