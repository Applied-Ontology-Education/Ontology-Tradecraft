PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
# Zero rows means this quality check passes.
SELECT ?property ?domain ?range WHERE {
      VALUES (?property ?domain ?range) { (<https://example.org/ontologies/intel-ontology#arrives_at_station> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#railway_station>) (<https://example.org/ontologies/intel-ontology#departs_from_station> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#railway_station>) (<https://example.org/ontologies/intel-ontology#has_scheduled_departure_time> <https://example.org/ontologies/intel-ontology#rail_journey_plan> <http://www.w3.org/2001/XMLSchema#dateTime>) (<https://example.org/ontologies/intel-ontology#has_train_number> <https://example.org/ontologies/intel-ontology#train> <http://www.w3.org/2001/XMLSchema#string>) (<https://example.org/ontologies/intel-ontology#specifies_rail_journey> <https://example.org/ontologies/intel-ontology#rail_journey_plan> <https://example.org/ontologies/intel-ontology#rail_journey>) (<https://example.org/ontologies/intel-ontology#uses_train> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#train>) }
      FILTER (NOT EXISTS { ?property rdfs:domain ?domain } ||
              NOT EXISTS { ?property rdfs:range ?range })
    }
