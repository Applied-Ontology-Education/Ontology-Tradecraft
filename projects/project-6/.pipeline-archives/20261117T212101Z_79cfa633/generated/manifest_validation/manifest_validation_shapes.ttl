<https://example.org/ontologies/project6/manifest-validation#node-shape-3> a sh:NodeShape ;
    sh:class <https://example.org/ontologies/intel-ontology#air_flight> ;
    sh:property [ a sh:PropertyShape ;
            sh:class <https://www.commoncoreontologies.org/AgentOntology/Flight_plan> ;
