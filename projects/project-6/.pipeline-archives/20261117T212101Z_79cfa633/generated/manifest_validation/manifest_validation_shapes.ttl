@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:Class rdfs:subClassOf rdfs:Class .

owl:DatatypeProperty rdfs:subClassOf rdf:Property .

<https://example.org/ontologies/project6/manifest-validation#material-flight-plan-document> a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:class <https://www.commoncoreontologies.org/AgentOntology/Flight_plan> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000101> ] ;
    sh:targetNode <https://example.org/ontologies/intel-ontology/manifest#physical_flight_plan_document_4d1ba9d87eb37afe27ac4732> .

<https://example.org/ontologies/project6/manifest-validation#node-shape-0> a sh:NodeShape ;
    sh:class <https://www.commoncoreontologies.org/AgentOntology/Flight_plan> ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://example.org/ontologies/intel-ontology#has_planned_air_departure_time> ],
        [ a sh:PropertyShape ;
            sh:class <https://www.commoncoreontologies.org/AgentOntology/Act_of_Flight_Plan> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <http://purl.obolibrary.org/obo/IAO_0000136> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://example.org/ontologies/intel-ontology#has_flight_service_code> ] ;
    sh:targetNode <https://example.org/ontologies/intel-ontology/manifest#flight_plan_8302802d6754b75ac50f1f98> .

<https://example.org/ontologies/project6/manifest-validation#node-shape-1> a sh:NodeShape ;
    sh:class <https://example.org/ontologies/intel-ontology#passenger_train> ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://example.org/ontologies/intel-ontology#has_train_arrival_station_name> ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://example.org/ontologies/intel-ontology#has_train_departure_station_name> ] ;
    sh:targetNode <https://example.org/ontologies/intel-ontology/manifest#passenger_train_48b0841663ee3158822f1ab4>,
        <https://example.org/ontologies/intel-ontology/manifest#passenger_train_a2dc45ea1db421200d07aa7e> .

<https://example.org/ontologies/project6/manifest-validation#node-shape-2> a sh:NodeShape ;
    sh:class <https://example.org/ontologies/intel-ontology#rail_journey_plan> ;
    sh:property [ a sh:PropertyShape ;
            sh:class <https://example.org/ontologies/intel-ontology#railway_station> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://example.org/ontologies/intel-ontology#has_planned_arrival_station> ],
        [ a sh:PropertyShape ;
            sh:class <https://example.org/ontologies/intel-ontology#passenger_train> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://example.org/ontologies/intel-ontology#plans_to_use_train> ],
        [ a sh:PropertyShape ;
            sh:class <https://example.org/ontologies/intel-ontology#railway_station> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://example.org/ontologies/intel-ontology#has_planned_departure_station> ] ;
    sh:targetNode <https://example.org/ontologies/intel-ontology/manifest#rail_journey_plan_2470c7be67fcf2c051c49a93>,
        <https://example.org/ontologies/intel-ontology/manifest#rail_journey_plan_8b2d2217e1e54a99769801bf>,
