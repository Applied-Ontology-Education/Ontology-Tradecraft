<https://example.org/ontologies/project6/manifest-validation#node-shape-4> a sh:NodeShape ;
    sh:class <https://example.org/ontologies/intel-ontology#rail_journey> ;
    sh:property [ a sh:PropertyShape ;
            sh:class <https://example.org/ontologies/intel-ontology#railway_station> ;
            sh:maxCount 1 ;
