PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
# Zero rows means this quality check passes.
SELECT ?entity WHERE {
          VALUES ?entity { <https://example.org/ontologies/intel-ontology#arrives_at_station> <https://example.org/ontologies/intel-ontology#departs_from_station> <https://example.org/ontologies/intel-ontology#has_service_identifier> <https://example.org/ontologies/intel-ontology#has_station_code> <https://example.org/ontologies/intel-ontology#has_train_participant> <https://example.org/ontologies/intel-ontology#passenger_train> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#rail_journey_plan> <https://example.org/ontologies/intel-ontology#rail_passenger_role> <https://example.org/ontologies/intel-ontology#rail_reservation_information> <https://example.org/ontologies/intel-ontology#rail_ticket> <https://example.org/ontologies/intel-ontology#railway_station> <https://example.org/ontologies/intel-ontology#realizes_rail_passenger_role> <https://example.org/ontologies/intel-ontology#train> }
          FILTER NOT EXISTS { ?entity <http://www.w3.org/2000/01/rdf-schema#label> ?annotation .
            FILTER (LANGMATCHES(LANG(?annotation), "en") && STRLEN(STR(?annotation)) > 0) }
        }
