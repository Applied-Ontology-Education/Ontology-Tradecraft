PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
# Zero rows means this quality check passes.
SELECT ?property ?wrongType WHERE {
      VALUES (?property ?wrongType) { (<https://example.org/ontologies/intel-ontology#arrives_at_station> <http://www.w3.org/2002/07/owl#DatatypeProperty>) (<https://example.org/ontologies/intel-ontology#departs_from_station> <http://www.w3.org/2002/07/owl#DatatypeProperty>) (<https://example.org/ontologies/intel-ontology#has_train_participant> <http://www.w3.org/2002/07/owl#DatatypeProperty>) (<https://example.org/ontologies/intel-ontology#realizes_rail_passenger_role> <http://www.w3.org/2002/07/owl#DatatypeProperty>) (<https://example.org/ontologies/intel-ontology#has_service_identifier> <http://www.w3.org/2002/07/owl#ObjectProperty>) (<https://example.org/ontologies/intel-ontology#has_station_code> <http://www.w3.org/2002/07/owl#ObjectProperty>) }
      ?property rdf:type ?wrongType .
    }
