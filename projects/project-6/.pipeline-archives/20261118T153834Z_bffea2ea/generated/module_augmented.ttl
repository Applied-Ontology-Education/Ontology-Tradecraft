#################################################################
#    General axioms
#################################################################

[ owl:intersectionOf ( :person
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :is_author_of ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Post
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty obo:BFO_0000101 ;
                                                                     owl:someValuesFrom :Facebook_Post
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ]
                       ]
                     ) ;
  rdf:type owl:Class ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty obo:RO_0000087 ;
                    owl:someValuesFrom :social_media_user
                  ]
] .


[ owl:intersectionOf ( :person
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :is_author_of ;
                         owl:someValuesFrom [ owl:intersectionOf ( :Post
