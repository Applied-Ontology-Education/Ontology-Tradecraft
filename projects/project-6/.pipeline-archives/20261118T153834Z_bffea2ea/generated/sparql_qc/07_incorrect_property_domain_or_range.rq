PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
# Zero rows means this quality check passes.
SELECT ?property ?domain ?range WHERE {
      VALUES (?property ?domain ?range) { (<https://example.org/ontologies/intel-ontology#arrives_at_railway_station> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#railway_station>) (<https://example.org/ontologies/intel-ontology#departs_from_railway_station> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#railway_station>) (<https://example.org/ontologies/intel-ontology#has_planned_departure_time> <https://example.org/ontologies/intel-ontology#rail_journey_plan> <http://www.w3.org/2001/XMLSchema#dateTime>) (<https://example.org/ontologies/intel-ontology#has_rail_service_code> <https://example.org/ontologies/intel-ontology#rail_journey_plan> <http://www.w3.org/2001/XMLSchema#string>) (<https://example.org/ontologies/intel-ontology#is_concretized_by_rail_ticket> <https://example.org/ontologies/intel-ontology#rail_reservation_information> <https://example.org/ontologies/intel-ontology#rail_ticket>) (<https://example.org/ontologies/intel-ontology#occurs_on_train> <https://example.org/ontologies/intel-ontology#rail_journey> <https://example.org/ontologies/intel-ontology#train>) }
      FILTER (NOT EXISTS { ?property rdfs:domain ?domain } ||
              NOT EXISTS { ?property rdfs:range ?range })
    }
