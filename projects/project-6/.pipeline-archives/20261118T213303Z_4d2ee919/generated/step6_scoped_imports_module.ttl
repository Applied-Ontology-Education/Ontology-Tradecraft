                                             <http://purl.obolibrary.org/obo/IAO_0000111> "material information bearer"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A page of a paperback novel with writing on it. The paper itself is a material information bearer, the pattern of ink is the information carrier."@en ,
                                                                                          "a brain"@en ,
                                                                                          "a hard drive"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000114> <http://purl.obolibrary.org/obo/IAO_0000122> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A material entity in which a concretization of an information content entity inheres."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000117> "GROUP: IAO"@en ;
                                             rdfs:label "material information bearer"@en .


