obo:BFO_0000196 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    skos:definition "b bearer of c =Def c inheres in b"@en .

cco:ont00001769 a owl:DatatypeProperty ;
    rdfs:label "has decimal value"@en ;
    skos:definition "A data property that has as its range a decimal value."@en .

cco:ont00001863 a owl:ObjectProperty ;
    rdfs:label "uses measurement unit"@en ;
    skos:definition "y uses_measurement_unit x iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en .

cco:ont00001966 a owl:ObjectProperty ;
    rdfs:label "is a measurement of"@en ;
    skos:definition "x is_a_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en .

ex:Ohm a cco:ont00000120 .

obo:BFO_0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en .

obo:BFO_0000004 a owl:Class ;
    rdfs:label "independent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "b is an independent continuant =Def b is a continuant & there is no c such that b specifically depends on c or b generically depends on c"@en .

obo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf obo:BFO_0000020 ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en .

obo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "(Elucidation) A generically dependent continuant is an entity that exists in virtue of the fact that there is at least one of what may be multiple copies which is the content or the pattern that multiple copies would share"@en .

obo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    rdfs:subClassOf obo:BFO_0000004 ;
    skos:definition "(Elucidation) A material entity is an independent continuant has some portion of matter as continuant part"@en .

cco:ont00000958 a owl:Class ;
    rdfs:label "Information Content Entity"@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    skos:definition "A Generically Dependent Continuant that generically depends on some Information Bearing Entity and stands in relation of aboutness to some Entity."@en .

cco:ont00001004 a owl:Class ;
    rdfs:label "Measurement Unit of Electromagnetic Force"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the electromagnetic force between electrically charged entities."@en .

cco:ont00001090 a owl:Class ;
    rdfs:label "Measurement Unit of Pressure"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of Force applied perpendicular to a surface per unit area."@en .

ex:Boiler-09_pressure a obo:BFO_0000020 .

ex:Circuit-07_voltage a obo:BFO_0000020 .

ex:Circuit-12_resistance a obo:BFO_0000020 .

ex:Circuit-12_voltage a obo:BFO_0000020 .

ex:Pump-A1_pressure a obo:BFO_0000020 .

ex:Pump-A2_pressure a obo:BFO_0000020 .

cco:ont00000844 a owl:Class ;
    rdfs:label "Measurement Unit of Temperature"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the thermal energy in an object."@en .

cco:ont00000853 a owl:Class ;
    rdfs:label "Descriptive Information Content Entity"@en ;
    rdfs:subClassOf cco:ont00000958 ;
    skos:definition "An Information Content Entity that consists of a set of propositions that describe some Entity."@en .

cco:ont00001450 a owl:NamedIndividual,
        cco:ont00000120,
        cco:ont00001004 ;
    rdfs:label "Volt Measurement Unit"@en .

cco:ont00001606 a owl:NamedIndividual,
        cco:ont00000120,
        cco:ont00000844 ;
    rdfs:label "Degree Celsius Measurement Unit"@en .

cco:ont00001694 a owl:NamedIndividual,
        cco:ont00000120,
        cco:ont00001090 ;
    rdfs:label "Pounds Per Square Inch Measurement Unit"@en .

ex:Boiler-07_pressure a obo:BFO_0000020 .

ex:Boiler-07_temperature a obo:BFO_0000020,
        cco:ont00000441 .

ex:Chiller-4_temperature a obo:BFO_0000020,
        cco:ont00000441 .

ex:Kilopascal a cco:ont00000120 .

obo:BFO_0000002 a owl:Class ;
    rdfs:label "continuant"@en ;
    rdfs:subClassOf obo:BFO_0000001 ;
    skos:definition "(Elucidation) A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity"@en .

cco:ont00000441 a owl:Class ;
    rdfs:label "Temperature"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A Quality that inheres in a bearer in virtue of its thermal energy."@en .

ex:Chiller-3_temperature a obo:BFO_0000020,
        cco:ont00000441 .

cco:ont00001724 a owl:NamedIndividual,
        cco:ont00000120,
        cco:ont00000844 ;
    rdfs:label "Degree Fahrenheit Measurement Unit"@en .

cco:ont00000995 a owl:Class ;
    rdfs:label "Material Artifact"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:definition "A Material Entity that was designed by some Agent to realize a certain Function."@en .

cco:ont00000120 a owl:Class ;
    rdfs:label "Measurement Unit"@en ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes a definite magnitude of a physical quantity, defined and adopted by convention and/or by law, that is used as a standard for measurement of the same physical quantity."@en .

obo:BFO_0000020 a owl:Class ;
    rdfs:label "specifically dependent continuant"@en ;
    rdfs:subClassOf obo:BFO_0000002 ;
    skos:definition "b is a specifically dependent continuant =Def b is a continuant & there is some independent continuant c which is not a spatial region & which is such that b specifically depends on c"@en .

cco:ont00001163 a owl:Class ;
    rdfs:label "Measurement Information Content Entity"@en ;
    rdfs:subClassOf cco:ont00000853 ;
    skos:definition "A Descriptive Information Content Entity that describes the extent, dimensions, quantity, or quality of an Entity relative to some standard."@en .

