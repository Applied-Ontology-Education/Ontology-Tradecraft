ex:hasReportedUnit a owl:ObjectProperty ;
    rdfs:label "has reported unit"@en ;
    skos:definition "Relates a converted measurement to the unit in which the sensor originally reported it."@en .

ex:hasReportedValue a owl:DatatypeProperty ;
    rdfs:label "has reported value"@en ;
    skos:definition "Relates a converted measurement to the numeric value the sensor originally reported, before unit normalization."@en .

ex:measure_cco a owl:Ontology ;
    rdfs:label "Sensor Measurements (CCO measurement pattern)"@en ;
    skos:definition "Readings from the site sensors, integrated as BFO/CCO measurements."@en .

ex:ElectricalResistanceQuality a owl:Class ;
    rdfs:label "Electrical Resistance Quality"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A quality of a conductor consisting in the degree to which it opposes the flow of electric current."@en .

ex:VoltageQuality a owl:Class ;
    rdfs:label "Voltage Quality"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A quality of an electrical circuit consisting in the difference in electric potential between two of its points."@en .

