# Title: 
#     Ontology Title Required
# Constraint Description: 
#     Any owl:Ontology must have an rdfs:label.
# Severity:
#     Warning
# A valid ontology should return ZERO rows.

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?ontology ?error
WHERE {
  ?ontology a owl:Ontology .
  FILTER NOT EXISTS { ?ontology rdfs:label ?label }
  BIND (concat("WARNING: The ontology ", str(?ontology), " has no rdfs:label.") AS ?error)
}
