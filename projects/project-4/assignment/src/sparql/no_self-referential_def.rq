# Title:  
#    No cyclical definitions
# Constraint Description:  
#    No class definition should be self-referential. 
# Severity:  
#    Error

PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Find classes where the definition contains the label name.
SELECT ?class ?label ?def #pull label and definition for the class.
WHERE {
  ?class a owl:Class ;
         rdfs:label ?label ;
         skos:definition ?def .
  FILTER (CONTAINS(LCASE(STR(?def)), LCASE(STR(?label))))
}