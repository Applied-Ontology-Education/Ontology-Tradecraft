# Title:  
#    Class SubClassOf Hierarchy Circularity
# Constraint Description:  
#    No class should appear in a circular `subClassOf` hierarchy.
# Severity:  
#    Error

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT DISTINCT ?class ?error
WHERE {
  ?class a owl:Class .
  ?class rdfs:subClassOf+ ?class .
  FILTER (!isBlank(?class))
  BIND (concat("ERROR: The following class appears in a circular subClassOf hierarchy ", str(?class)) AS ?error)
}
ORDER BY (str(?class))