# Title:
#    Definition Required
# Constraint Description:
#    Any class or object property must have a non-empty
#    definition with an English language tag.
# Severity:
#    Warning

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>

SELECT DISTINCT ?element ?error
WHERE {

    ?element rdf:type ?elementType .

    VALUES ?elementType {
        owl:Class
        rdfs:Class
        owl:ObjectProperty
    }

    FILTER(isIRI(?element))

    FILTER NOT EXISTS {

        ?element ?definitionProperty ?definition .

        VALUES ?definitionProperty {
            skos:definition
            obo:IAO_0000115
        }

        FILTER(isLiteral(?definition))

        FILTER(
            STRLEN(
                REPLACE(
                    STR(?definition),
                    "^\\s+|\\s+$",
                    ""
                )
            ) > 0
        )

        FILTER(
            LANGMATCHES(
                LANG(?definition),
                "en"
            )
        )
    }

    BIND(
        CONCAT(
            "WARNING: Element lacks a non-empty English definition: ",
            STR(?element)
        )
        AS ?error
    )
}

ORDER BY ?element