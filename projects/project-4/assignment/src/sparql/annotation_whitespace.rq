# Title:
#    No Extra Annotation Whitespace
# Constraint Description:
#    No annotation value may have leading or trailing whitespace.
# Severity:
#    Error
# Valid: ZERO rows.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT ?element ?property ?value ?error
WHERE {
  VALUES ?property { rdfs:label rdfs:comment skos:definition skos:altLabel skos:prefLabel }
  ?element ?property ?value .
  FILTER(isLiteral(?value))
  FILTER(REGEX(STR(?value), "^\\s|\\s$"))
  BIND(CONCAT("ERROR: leading/trailing whitespace in ", STR(?property), " of ", STR(?element)) AS ?error)
}
