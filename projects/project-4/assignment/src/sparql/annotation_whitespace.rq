# Title: 
#    No Extra Annotation Whitespace
# Constraint Description: 
#    No annotation value may have leading or trailing whitespace.    
# Severity:
#    Error 
# A valid ontology should return ZERO rows.

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?element ?property ?value ?error
WHERE {
  VALUES ?property { rdfs:label rdfs:comment skos:definition dcterms:description
                      <http://purl.obolibrary.org/obo/IAO_0000115> }
  ?element ?property ?value .
  FILTER (isLiteral(?value))
  FILTER (REGEX(STR(?value), "^\\s") || REGEX(STR(?value), "\\s$"))
  BIND (concat("ERROR: The annotation value on ", str(?element), " has leading or trailing whitespace: '", str(?value), "'") AS ?error)
}
