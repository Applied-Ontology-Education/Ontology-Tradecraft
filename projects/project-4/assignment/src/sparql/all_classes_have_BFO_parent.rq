# Title: 
#    No Class Should Be Outside the BFO Hierarchy
# Constraint Description: 
#     All classes must have a BFO superclass.
# Severity:
#     Error
# Reminder: https://www.w3.org/TR/sparql11-query/#func-strstarts

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>

SELECT DISTINCT ?class
WHERE {
  ?class a owl:Class .
  FILTER (!isBlank(?class))
  FILTER NOT EXISTS {
    ?class rdfs:subClassOf+ ?bfoClass .
    FILTER (STRSTARTS(STR(?bfoClass), "http://purl.obolibrary.org/obo/BFO_"))
    }
  BIND (concat("ERROR: The following class has no BFO superclass ", str(?class)) AS ?error)
}