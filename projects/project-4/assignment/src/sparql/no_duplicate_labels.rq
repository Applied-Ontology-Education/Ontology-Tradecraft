# Title:
#     No Duplicate Labels
# Constraint Description:
#     No two ontology elements shall have the same rdfs:label.
# Severity:
#     Warning
#
# Compares lexical forms (language tags ignored), so "Pump"@en and "Pump" collide. Each clash is
# reported once. A valid ontology returns ZERO rows.

PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?element ?element2 ?label ?error
WHERE {
  ?element  rdfs:label ?label .
  ?element2 rdfs:label ?label2 .
  FILTER (STR(?label) = STR(?label2))
  FILTER (!isBlank(?element) && !isBlank(?element2))
  FILTER (STR(?element) < STR(?element2))
  BIND (CONCAT("WARNING: ", STR(?element), " and ", STR(?element2), " share the rdfs:label '", STR(?label), "'") AS ?error)
}
ORDER BY DESC(UCASE(STR(?label)))
