# Title:
#    No Duplicate Definitions
# Constraint Description:
#    No two ontology elements may have the exact same definition.
# Severity:
#     Error
#
# Compares lexical forms (language tags ignored). Each clash is reported once. A valid ontology
# returns ZERO rows.

PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?element ?element2 ?definition ?error
WHERE {
  ?element  skos:definition ?definition .
  ?element2 skos:definition ?definition2 .
  FILTER (STR(?definition) = STR(?definition2))
  FILTER (STR(?element) < STR(?element2))
  BIND (CONCAT("ERROR: ", STR(?element), " and ", STR(?element2), " share a definition") AS ?error)
}
