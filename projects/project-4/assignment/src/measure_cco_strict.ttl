obo:BFO_0000058 a owl:ObjectProperty ;
    rdfs:label "is concretized by"@en ;
    skos:definition "c is concretized by b =Def b concretizes c"@en .

obo:BFO_0000196 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    skos:definition "b bearer of c =Def c inheres in b"@en .

obo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en ;
    skos:definition "b inheres in c =Def b is a specifically dependent continuant & c is an independent continuant that is not a spatial region & b specifically depends on c"@en .

cco:ont00001767 a owl:DatatypeProperty ;
    rdfs:label "has datetime value"@en ;
    skos:definition "A data property that has as its value a datetime value."@en .

cco:ont00001769 a owl:DatatypeProperty ;
    rdfs:label "has decimal value"@en ;
    skos:definition "A data property that has as its range a decimal value."@en .

cco:ont00001863 a owl:ObjectProperty ;
    rdfs:label "uses measurement unit"@en ;
    skos:definition "y uses_measurement_unit x iff y is an instance of Information Bearing Entity and x is an instance of Measurement Unit, such that x describes the magnitude of measured physical quantity mentioned in y."@en .

cco:ont00001966 a owl:ObjectProperty ;
    rdfs:label "is a measurement of"@en ;
    skos:definition "x is_a_measurement_of y iff x is an instance of Information Content Entity and y is an instance of Entity, such that x describes some attribute of y relative to some scale or classification scheme."@en .

ex:ElectricPotentialDifference a owl:Class ;
    rdfs:label "Electric Potential Difference"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A quality of an electrical circuit that is the work needed per unit charge to move a test charge between two of its terminals."@en .

ex:ElectricalResistance a owl:Class ;
    rdfs:label "Electrical Resistance"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A quality of a conductor that is the opposition it offers to the passage of an electric current."@en .

ex:MeasurementUnitOfElectricalResistance a owl:Class ;
    rdfs:label "Measurement Unit of Electrical Resistance"@en ;
    rdfs:subClassOf cco:ont00000120 ;
    skos:definition "A Measurement Unit that is used as a standard for measurement of the opposition of a conductor to electric current."@en .

ex:Ohm a ex:MeasurementUnitOfElectricalResistance,
        owl:NamedIndividual,
        cco:ont00000120 ;
    rdfs:label "Ohm Measurement Unit"@en .

