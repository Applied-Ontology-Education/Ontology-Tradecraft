###  https://www.commoncoreontologies.org/ont00001580
cco:ont00001580 rdf:type owl:NamedIndividual ,
                         cco:ont00001235 ;
                rdfs:label "Papa Time Zone"@en ;
                skos:scopeNote "Offset from Universal Coordinated Time = UTC-3"@en ;
