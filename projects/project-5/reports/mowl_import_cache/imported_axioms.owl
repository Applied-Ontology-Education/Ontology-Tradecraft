    <!-- https://www.commoncoreontologies.org/ont00001412 -->

    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001412">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00001352"/>
        <rdfs:label xml:lang="en">GMT</rdfs:label>
        <skos:altLabel xml:lang="en">Greenwich Mean Time</skos:altLabel>
        <skos:scopeNote xml:lang="en">Offset from Universal Coordinated Time = UTC+0</skos:scopeNote>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


    <!-- https://www.commoncoreontologies.org/ont00001414 -->

    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001414">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00001328"/>
        <rdfs:label xml:lang="en">Terrestrial Time</rdfs:label>
        <skos:scopeNote xml:lang="en">TT is an astronomical time standard that is a theoretical ideal designed to be free of the irregularities in Earth&apos;s rotation and is primarily used for time measurements of astronomical observations made from the surface of Earth. It was formerly called Terrestrial Dynamical Time (TDT), which was formulated to replace Ephemeris Time (ET).</skos:scopeNote>
        <www:ont00001753>TT</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


    <!-- https://www.commoncoreontologies.org/ont00001417 -->

    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001417">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00001328"/>
        <rdfs:label xml:lang="en">Ephemeris Time</rdfs:label>
        <skos:scopeNote xml:lang="en">ET is an astronomical time scale that was adopted as a standard in 1952 by the IAU but has since been superseded and is no longer actively used. ET is based on the ephemeris second, which was defined as a fraction of the tropical year for 1900 January 01 as calculated using Newcomb&apos;s 1895 tables of the Sun. ET was designed to avoid problems caused by variations in Earth&apos;s rotational period and was used for Solar System ephemeris calculations until being replaced by Terrestrial Dynamical Time (TDT) in 1979.</skos:scopeNote>
        <www:ont00001753>ET</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


