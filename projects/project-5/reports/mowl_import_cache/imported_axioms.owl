    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001582">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00000469"/>
        <rdfs:label xml:lang="en">Universal Transverse Mercator Reference System</rdfs:label>
        <www:ont00001753>UTM</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


    <!-- https://www.commoncoreontologies.org/ont00001584 -->

