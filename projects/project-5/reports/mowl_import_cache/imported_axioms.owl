        <rdfs:label xml:lang="en">Email Address</rdfs:label>
        <skos:altLabel xml:lang="en">Email Box Identifier</skos:altLabel>
        <skos:definition xml:lang="en">A Designative Name created in order to identify some Email Box as the destination of an email message for the purpose of Email Messaging.</skos:definition>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:Class>
    


    <!-- https://www.commoncoreontologies.org/ont00002073 -->

    <owl:Class rdf:about="https://www.commoncoreontologies.org/ont00002073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">Sensor Role</rdfs:label>
        <skos:definition xml:lang="en">A Role that inheres in an entity in virtue of it being used in a process wherein an attribute of its bearer acts as a proxy for some aspect of its sensing environment.</skos:definition>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ArtifactOntology</www:ont00001760>
    </owl:Class>
    


    <!-- https://www.commoncoreontologies.org/ont00002074 -->

    <owl:Class rdf:about="https://www.commoncoreontologies.org/ont00002074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:label xml:lang="en">Sensor Platform Role</rdfs:label>
        <skos:definition xml:lang="en">A Role that inheres in an entity in virtue of it being used to support or convey a Sensor during its deployment and functioning.</skos:definition>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/ArtifactOntology</www:ont00001760>
    </owl:Class>
    


