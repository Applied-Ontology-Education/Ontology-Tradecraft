        <rdfs:label xml:lang="en">Romeo Time Zone</rdfs:label>
        <skos:scopeNote xml:lang="en">Offset from Universal Coordinated Time = UTC-5</skos:scopeNote>
        <www:ont00001753>R</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


    <!-- https://www.commoncoreontologies.org/ont00001716 -->

    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001716">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00000630"/>
        <rdfs:label xml:lang="en">Universal Time 1</rdfs:label>
        <skos:altLabel xml:lang="en">Astronomical Time</skos:altLabel>
        <skos:scopeNote xml:lang="en">UT1 is a derivation of UT0 that takes into account distortions caused by polar motion and is proportional to the rotation angle of the Earth with respect to distant quasars, specifically, the International Celestial Reference Frame (ICRF). UT1 is currently the most widely used variant of Universal Time and has the same value everywhere on Earth.</skos:scopeNote>
        <www:ont00001753>UT1</www:ont00001753>
        <www:ont00001760 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.commoncoreontologies.org/InformationEntityOntology</www:ont00001760>
    </owl:NamedIndividual>
    


