    <!-- https://www.commoncoreontologies.org/ont00001624 -->

    <owl:NamedIndividual rdf:about="https://www.commoncoreontologies.org/ont00001624">
        <rdf:type rdf:resource="https://www.commoncoreontologies.org/ont00001235"/>
        <rdfs:label xml:lang="en">Golf Time Zone</rdfs:label>
