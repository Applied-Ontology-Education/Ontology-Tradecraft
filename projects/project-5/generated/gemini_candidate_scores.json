  "[{\"subclass_definition\": \"Semicircular is a Shape Quality that inheres in a bearer in virtue of the bearer having the shape of half a circle.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000042\", \"superclass_definition\": \"Curved is a Shape Quality that inheres in a bearer in virtue of the bearer having borders that are smoothly rounded.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000474\"}, {\"subclass_definition\": \"Cylindrical is a Three Dimensional Shape that inheres in a bearer in virtue of the bearer having an elongated shape with two parallel bases that have a Round shape.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000283\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Triangular is a Shape Quality that inheres in a bearer in virtue of the bearer having exactly three sides and exactly three angles.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000447\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Triangular is a Shape Quality that inheres in a bearer in virtue of the bearer having exactly three sides and exactly three angles.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000447\", \"superclass_definition\": \"Bent is a Shape Quality that inheres in a bearer in virtue of the bearer having one or more angles along its border.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000991\"}, {\"subclass_definition\": \"Oblong is a Shape Quality that inheres in a bearer in virtue of the bearer having a long, thin shape with approximately parallel sides.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000464\", \"superclass_definition\": \"Thin is a Shape Quality that inheres in a bearer in virtue of the bearer having a width or depth that is significantly smaller in proportion to its length or height.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000579\"}, {\"subclass_definition\": \"Cuboidal is a Three Dimensional Shape that inheres in a bearer in virtue of the bearer having six faces, each of which has a Rectangular shape.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000478\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Serrated is a Shape Quality that inheres in a bearer in virtue of the bearer having multiple sharp points along an edge.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000494\", \"superclass_definition\": \"Sharp is a Shape Quality that inheres in a bearer in virtue of the bearer having a fine point or thin edge.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000424\"}, {\"subclass_definition\": \"Serrated is a Shape Quality that inheres in a bearer in virtue of the bearer having multiple sharp points along an edge.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000494\", \"superclass_definition\": \"Bent is a Shape Quality that inheres in a bearer in virtue of the bearer having one or more angles along its border.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont0000099