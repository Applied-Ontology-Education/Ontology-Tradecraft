superclass_iri\": \"https://www.commoncoreontologies.org/ont00000474\"}, {\"subclass_definition\": \"Round is a Shape Quality that inheres in a bearer in virtue of every point along the bearer's circumference being equidistant from the bearer's center.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000803\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Coiled is a Shape Quality that inheres in a bearer in virtue of the bearer being wound in concentric rings or spirals.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000805\", \"superclass_definition\": \"Curved is a Shape Quality that inheres in a bearer in virtue of the bearer having borders that are smoothly rounded.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000474\"}, {\"subclass_definition\": \"Wavy is a Shape Quality that inheres in a bearer in virtue of the bearer having a sinuous or rippled border.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000885\", \"superclass_definition\": \"Curved is a Shape Quality that inheres in a bearer in virtue of the bearer having borders that are smoothly rounded.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000474\"}, {\"subclass_definition\": \"Pyramidal is a Three Dimensional Shape that inheres in a bearer in virtue of the bearer having a polygonal base whose vertices all connect to a single apex, forming faces that have a Triangular shape.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00000912\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Rectangular is a Shape Quality that inheres in a bearer in virtue of the bearer having four sides and four 90-degree angles.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00001369\", \"superclass_definition\": \"Convex Shape is a Shape Quality that inheres in a bearer in virtue of the bearer not having a cavity, such that no line segment connecting a pair of points on the surface of the bearer lies outside the bearer.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000590\"}, {\"subclass_definition\": \"Rectangular is a Shape Quality that inheres in a bearer in virtue of the bearer having four sides and four 90-degree angles.\", \"subclass_iri\": \"https://www.commoncoreontologies.org/ont00001369\", \"superclass_definition\": \"Bent is a Shape Quality that inheres in a bearer in virtue of the bearer having one or more angles along its border.\", \"superclass_iri\": \"https://www.commoncoreontologies.org/ont00000991\"}]": [
